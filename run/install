#!/usr/bin/env bash
#
# Restore this repo's Pop!_OS / Cosmic desktop backups onto the current
# machine. Mirrors the manual steps documented in README.md.
#
# Usage:
#   ./run/install [options]
#
# Options:
#   -y, --yes        Don't prompt before overwriting ~/.config/cosmic.
#       --copy-backgrounds
#                     Copy src/Documents/Backgrounds instead of symlinking it.
#       --no-autostart
#                     Don't install the startup-workspaces autostart entry.
#   -n, --dry-run     Print what would happen without changing anything.
#   -h, --help        Show this help and exit.
#
# What it does NOT do:
#   - Import Dark.ron. Cosmic Settings has no CLI/import hook for desktop
#     appearance; apply it manually via Desktop > Appearance in Cosmic
#     Settings.
#   - Take effect on the startup-workspaces autostart entry until the next
#     fresh login. systemd --user reads environment.d once at session
#     start, so it won't pick up a freshly-installed COSMIC_STARTUP_APPS
#     mid-session.

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &>/dev/null && pwd)"
SRC_DIR="${REPO_ROOT}/src"

# cos-cli (https://github.com/estin/cos-cli) has no tagged releases, so this
# pins a known-good commit rather than floating on `main`. It's a
# third-party tool, unaffiliated with System76 — bump this deliberately,
# not automatically.
COS_CLI_GIT="https://github.com/estin/cos-cli"
COS_CLI_REV="fe8c52016888302d6239ef53f1dbf876d8552dc2"  # 0.5.1, 2026-05-14

ASSUME_YES=0
DRY_RUN=0
COPY_BACKGROUNDS=0
NO_AUTOSTART=0

usage() {
  sed -n '2,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes) ASSUME_YES=1 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    --copy-backgrounds) COPY_BACKGROUNDS=1 ;;
    --no-autostart) NO_AUTOSTART=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

log() { printf '==> %s\n' "$*"; }
run() {
  if [ "${DRY_RUN}" -eq 1 ]; then
    printf '[dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

confirm() {
  local prompt="$1"
  if [ "${ASSUME_YES}" -eq 1 ] || [ "${DRY_RUN}" -eq 1 ]; then
    return 0
  fi
  read -r -p "${prompt} [y/N] " reply
  [[ "${reply}" =~ ^[Yy]$ ]]
}

require_cmd() {
  if ! command -v "$1" &>/dev/null; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

# cos-cli is a CLI tool for managing windows and workspaces on the COSMIC
# Desktop Environment (Wayland). It has no packaged distribution, so this
# builds it from source at a pinned revision (see COS_CLI_REV above).
install_cos_cli() {
  # rustup installs to ~/.cargo/bin, which isn't on PATH unless ~/.cargo/env
  # has been sourced — and nothing sources it in a non-interactive run. Look
  # there explicitly, or an existing toolchain reads as "Rust not installed"
  # and this quietly no-ops.
  local cargo_bin="${HOME}/.cargo/bin"
  PATH="${cargo_bin}:${PATH}"

  if command -v cos-cli &>/dev/null; then
    log "cos-cli already installed: $(command -v cos-cli)"
    return
  fi

  if ! command -v cargo &>/dev/null; then
    log "NOTE: cos-cli not found and cargo isn't installed, so it can't be"
    log "      built automatically. Install Rust (https://rustup.rs) then"
    log "      re-run this script, or install manually:"
    log "      cargo install --git ${COS_CLI_GIT} --rev ${COS_CLI_REV} --locked"
    return
  fi

  if ! confirm "cos-cli not found. Build and install it now via cargo (pinned rev ${COS_CLI_REV:0:7})?"; then
    log "Skipping cos-cli install."
    return
  fi

  log "Installing cos-cli (cargo install --git ${COS_CLI_GIT} --rev ${COS_CLI_REV})"
  run cargo install --git "${COS_CLI_GIT}" --rev "${COS_CLI_REV}" --locked cos-cli
}

# 1. Cosmic desktop settings (theme, layout, panel/dock, keyboard shortcuts).
restore_cosmic_settings() {
  local archive="${SRC_DIR}/cosmic-settings-backup.tar.gz"
  local target="${HOME}/.config/cosmic"

  if [ ! -f "${archive}" ]; then
    log "Skipping Cosmic settings: ${archive} not found."
    return
  fi

  require_cmd tar

  if [ -e "${target}" ] || [ -L "${target}" ]; then
    log "Cosmic settings dir already exists: ${target}"
    if ! confirm "Overwrite ~/.config/cosmic with the backup?"; then
      log "Skipping Cosmic settings restore."
      return
    fi
  fi

  log "Restoring Cosmic settings to ${target}"
  run mkdir -p "${HOME}/.config"
  run tar -xzf "${archive}" -C "${HOME}/.config"
}

# 2. Application settings (dconf dump).
restore_dconf_settings() {
  local dump="${SRC_DIR}/pop_os_settings.dconf"

  if [ ! -f "${dump}" ]; then
    log "Skipping dconf settings: ${dump} not found."
    return
  fi

  if ! command -v dconf &>/dev/null; then
    log "Skipping dconf settings: dconf command not found."
    return
  fi

  if ! confirm "Load ${dump} into dconf (overwrites matching keys)?"; then
    log "Skipping dconf restore."
    return
  fi

  log "Loading dconf settings from ${dump}"
  if [ "${DRY_RUN}" -eq 1 ]; then
    printf '[dry-run] dconf load / < %s\n' "${dump}"
  else
    dconf load / < "${dump}"
  fi
}

# 3. Desktop wallpapers.
restore_backgrounds() {
  local backgrounds_src="${SRC_DIR}/Documents/Backgrounds"
  local backgrounds_dest="${HOME}/Documents/Backgrounds"

  if [ ! -d "${backgrounds_src}" ]; then
    log "Skipping backgrounds: ${backgrounds_src} not found."
    return
  fi

  run mkdir -p "${HOME}/Documents"

  if [ "${COPY_BACKGROUNDS}" -eq 1 ]; then
    log "Copying backgrounds to ${backgrounds_dest}"
    run cp -r "${backgrounds_src}" "${backgrounds_dest}"
  else
    # If backgrounds_dest already exists as a real directory (not a symlink),
    # `ln -sf` won't replace it — it'll create the link *inside* it instead
    # (backgrounds_dest/Backgrounds -> backgrounds_src), nesting further on
    # every re-run. Clear that case out explicitly before symlinking.
    if [ -d "${backgrounds_dest}" ] && [ ! -L "${backgrounds_dest}" ]; then
      log "Backgrounds dir already exists (not a symlink): ${backgrounds_dest}"
      if ! confirm "Replace it with a symlink to ${backgrounds_src}?"; then
        log "Skipping backgrounds symlink."
        return
      fi
      run rm -rf "${backgrounds_dest}"
    fi

    log "Symlinking ${backgrounds_dest} -> ${backgrounds_src}"
    run ln --symbolic --force --no-target-directory "${backgrounds_src}" "${backgrounds_dest}"
  fi
}

# 4. Startup-workspaces script + its env config + autostart entry.
restore_startup_workspaces() {
  local script="${SRC_DIR}/cosmic-startup-workspaces.sh"
  local env_src="${SRC_DIR}/environment.d/cosmic-startup-workspaces.conf"
  local env_dir="${HOME}/.config/environment.d"
  local env_dest="${env_dir}/cosmic-startup-workspaces.conf"
  local autostart_dir="${HOME}/.config/autostart"
  local autostart_file="${autostart_dir}/cosmic-startup-workspaces.desktop"

  if [ ! -f "${script}" ]; then
    log "Skipping startup-workspaces: ${script} not found."
    return
  fi

  if [ "${NO_AUTOSTART}" -eq 1 ]; then
    log "Skipping autostart entry (--no-autostart)."
    return
  fi

  run chmod +x "${script}"

  install_cos_cli

  # App list (COSMIC_STARTUP_APPS): symlink the version-controlled config
  # into ~/.config/environment.d, where systemd --user reads it at login.
  if [ ! -f "${env_src}" ]; then
    log "Skipping env config: ${env_src} not found."
  elif [ -e "${env_dest}" ] && [ ! -L "${env_dest}" ] && ! confirm "Env config already exists at ${env_dest} (not a symlink). Overwrite it to point at this repo's config?"; then
    log "Skipping env config."
  else
    log "Symlinking ${env_dest} -> ${env_src}"
    run mkdir -p "${env_dir}"
    run ln --symbolic --force "${env_src}" "${env_dest}"
  fi

  if [ -e "${autostart_file}" ]; then
    log "Autostart entry already exists: ${autostart_file}"
    if ! confirm "Overwrite it to point at this repo's script?"; then
      log "Skipping autostart entry."
      return
    fi
  fi

  log "Installing autostart entry -> ${autostart_file}"
  log "  Exec target: ${script}"
  if [ "${DRY_RUN}" -eq 1 ]; then
    printf '[dry-run] write %s\n' "${autostart_file}"
  else
    mkdir -p "${autostart_dir}"
    cat > "${autostart_file}" <<-EOF
			[Desktop Entry]
			Type=Application
			Name=COSMIC Startup Workspaces
			Exec=${script}
			X-GNOME-Autostart-enabled=true
		EOF
  fi

  log "Note: COSMIC_STARTUP_APPS takes effect on the next fresh login, not"
  log "mid-session. To change the app list, edit ${env_src} in the repo."
}

restore_cosmic_settings
restore_dconf_settings
restore_backgrounds
restore_startup_workspaces

log "Done. Remaining manual step: apply src/Dark.ron via Cosmic Settings > Desktop > Appearance."
