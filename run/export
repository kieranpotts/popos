#!/usr/bin/env bash
#
# Export the current machine's Pop!_OS / Cosmic desktop configuration into
# this repo's src/ directory. The inverse of run/import.
#
# Usage:
#   ./run/export [options]
#
# Options:
#   -n, --dry-run     Print what would happen without changing anything.
#   -h, --help        Show this help and exit.
#
# Everything it writes is under version control, so review the result with
# `git diff --stat src` and discard anything unwanted with `git restore`.
#
# What it does NOT do:
#   - Export Dark.ron. Cosmic Settings has no CLI/export hook for desktop
#     appearance; export it manually via Desktop > Appearance in Cosmic
#     Settings, and save it over src/Dark.ron.
#   - Export the startup-workspaces config or autostart entry. The config is
#     symlinked into ~/.config/environment.d, so edits already land in this
#     repo, and the autostart entry is generated by run/import.

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &>/dev/null && pwd)"
SRC_DIR="${REPO_ROOT}/src"

DRY_RUN=0

usage() {
  sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

log() { printf '==> %s\n' "$*"; }
run() {
  if [ "${DRY_RUN}" -eq 1 ]; then
    printf '[dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

require_cmd() {
  if ! command -v "$1" &>/dev/null; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

# 1. Cosmic desktop settings (theme, layout, panel/dock, keyboard shortcuts).
export_cosmic_settings() {
  local source="${HOME}/.config/cosmic"
  local archive="${SRC_DIR}/cosmic-settings-backup.tar.gz"

  if [ ! -d "${source}" ]; then
    log "Skipping Cosmic settings: ${source} not found."
    return
  fi

  require_cmd tar
  require_cmd gzip

  log "Archiving ${source} -> ${archive}"
  if [ "${DRY_RUN}" -eq 1 ]; then
    printf '[dry-run] tar --sort=name -cf - -C %s cosmic | gzip -n > %s\n' "${HOME}/.config" "${archive}"
    return
  fi

  # Write to a temp file first, so a failed export can't leave a truncated
  # archive in place of the last good one. --sort=name and gzip -n keep the
  # output stable when nothing has changed, avoiding noise in `git diff`.
  local tmp="${archive}.tmp"
  tar --sort=name -cf - -C "${HOME}/.config" cosmic | gzip -n > "${tmp}"
  mv -f "${tmp}" "${archive}"
}

# 2. Application settings (dconf dump).
export_dconf_settings() {
  local dump="${SRC_DIR}/pop_os_settings.dconf"

  if ! command -v dconf &>/dev/null; then
    log "Skipping dconf settings: dconf command not found."
    return
  fi

  log "Dumping dconf settings -> ${dump}"
  if [ "${DRY_RUN}" -eq 1 ]; then
    printf '[dry-run] dconf dump / > %s\n' "${dump}"
    return
  fi

  local tmp="${dump}.tmp"
  dconf dump / > "${tmp}"
  mv -f "${tmp}" "${dump}"
}

# 3. Desktop wallpapers.
export_backgrounds() {
  local backgrounds_src="${HOME}/Documents/Backgrounds"
  local backgrounds_dest="${SRC_DIR}/Documents/Backgrounds"

  if [ ! -e "${backgrounds_src}" ]; then
    log "Skipping backgrounds: ${backgrounds_src} not found."
    return
  fi

  # run/import symlinks ~/Documents/Backgrounds to this repo by default, in
  # which case the repo already holds the live copy and there's nothing to do.
  if [ "$(realpath -- "${backgrounds_src}")" = "$(realpath -- "${backgrounds_dest}" 2>/dev/null)" ]; then
    log "Backgrounds already live in this repo (symlinked): ${backgrounds_src}"
    return
  fi

  log "Copying ${backgrounds_src} -> ${backgrounds_dest}"
  run rm -rf "${backgrounds_dest}"
  run mkdir -p "$(dirname -- "${backgrounds_dest}")"
  run cp -r "${backgrounds_src}" "${backgrounds_dest}"
}

export_cosmic_settings
export_dconf_settings
export_backgrounds

log "Done. Review the changes with: git -C ${REPO_ROOT} diff --stat src"
log "Remaining manual step: export Dark.ron via Cosmic Settings > Desktop > Appearance."
